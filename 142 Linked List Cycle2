# Definition for singly-linked list.
#   class ListNode:
#     def __init__(self, x):
#       self.val = x
#       self.next = None

class Solution:
    def detectCycle(self, head: Optional[ListNode]) -> Node:
        seen = set()
        current_node = head

        while current_node:
            if current_node in seen:
                return current_node
            seen.add(current_node)
            current_node = current_node.next
